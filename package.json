{
  "name": "hushd",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @hushd/db exec prisma generate",
    "db:migrate": "pnpm --filter @hushd/db exec prisma migrate dev",
    "db:validate": "pnpm --filter @hushd/db exec prisma validate",
    "db:migrate:deploy": "pnpm --filter @hushd/db exec prisma migrate deploy",
    "audit:deps": "pnpm audit --prod",
    "test:e2e": "pnpm --filter @hushd/e2e test"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.1.1",
      "lodash": "^4.18.0"
    }
  },
  "packageManager": "pnpm@9.14.2"
}
