# Copy to .env for local development (never commit real secrets)
# Host Postgres default. docker-compose.yml maps container 5432 → host 5433 to avoid
# colliding with a native Postgres on 5432 — use localhost:5433 when using compose.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hushd?schema=public"
REDIS_URL="redis://localhost:6379"
# API listen port
PORT="3001"
# Comma-separated browser origins allowed to call the API (web + admin).
# REQUIRED in production — the API refuses to start without it.
CORS_ORIGINS="http://localhost:3000,http://localhost:3010"
# Auth cookies (browser session transport). Defaults: SameSite=Lax, Secure in
# production. Set COOKIE_SAMESITE="none" only for split-site deployments
# (requires HTTPS; COOKIE_SECURE must stay "true").
# COOKIE_SAMESITE="lax"
# COOKIE_SECURE="true"
# Public base URL of the web app; used to build email verification/reset links
APP_WEB_URL="http://localhost:3000"
# Transactional email: "log" (dev — logs only) or "resend" (production).
# Production refuses EMAIL_PROVIDER=log. Resend requires RESEND_API_KEY.
EMAIL_PROVIDER="log"
EMAIL_FROM="no-reply@hushd.local"
RESEND_API_KEY=""
JWT_ACCESS_SECRET="change-me-access-min-32-chars-recommended!!"
JWT_REFRESH_SECRET="change-me-refresh-min-32-chars-recommended!!"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# 32+ char secret used to seal TOTP seeds at rest (AES-256-GCM)
ENCRYPTION_KEY="change-me-encryption-key-32chars!!"
# Set to false in production until IDV gates are wired; defaults to true for local DX
AUTH_AUTO_ACTIVATE="true"
PAYMENT_PROCESSORS_ENABLED="segpay_stub,ccbill_stub"
SEGPAY_WEBHOOK_SECRET="change-me-segpay-webhook-secret"
CCBILL_WEBHOOK_SECRET="change-me-ccbill-webhook-secret"
# Platform take rate in basis points (1500 = 15%)
PLATFORM_FEE_BPS="1500"
RECONCILIATION_ENABLED="true"
RECONCILIATION_INTERVAL_MS="600000"
RECONCILIATION_LOOKBACK_HOURS="24"
# Identity verification vendor: "noop" (dev default) or "veriff"
IDV_PROVIDER="noop"
VERIFF_BASE_URL="https://stationapi.veriff.com"
VERIFF_API_KEY=""
VERIFF_API_SECRET=""
# ID re-verification cadence; 0 = never expires. IDs default to ~5 years.
IDV_ID_TTL_DAYS="1825"
IDV_AGE_TTL_DAYS="0"
VERIFICATION_EXPIRY_SWEEP_ENABLED="true"
VERIFICATION_EXPIRY_SWEEP_INTERVAL_MS="3600000"
PAYOUT_HOLD_SCORE_THRESHOLD="30"
# Minimum payout request in cents
PAYOUT_MIN_CENTS="5000"
# Geo-block list cache refresh (enforced via cf-ipcountry header, 451 on match)
GEO_BLOCK_CACHE_MS="60000"
# Shared secret the edge/proxy sends as x-geo-edge-secret so the API can trust
# the cf-ipcountry header. REQUIRED in production — without it, geo headers are
# treated as untrusted (access geo-blocking is effectively disabled).
GEO_EDGE_SHARED_SECRET=""
# Worker alerting webhook (Slack/Discord-compatible JSON POST); empty = log only
ALERT_WEBHOOK_URL=""
# Object storage (Cloudflare R2, S3-compatible). Empty = stub URLs in dev.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_STAGING=""
R2_BUCKET_PUBLIC=""
R2_STAGING_PREFIX="staging/"
R2_PUBLIC_PREFIX="public/"
# Upload guardrails: max bytes per upload + signed URL TTLs (seconds)
MEDIA_MAX_UPLOAD_BYTES="524288000"
MEDIA_STAGING_PUT_TTL_SECONDS="900"
MEDIA_PUBLIC_READ_TTL_SECONDS="60"
# Cloudflare Stream ingest for video (empty = videos stay plain R2 objects)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
# CSAM scanning: "noop" (dev only) or "hashlist" (SHA-256 hash matching).
# Worker refuses CSAM_PROVIDER=noop when NODE_ENV=production.
CSAM_PROVIDER="noop"
CSAM_HASHLIST_FILE=""
CSAM_HASHLIST_URL=""
CSAM_HASHLIST_REFRESH_MS="600000"
# true = quarantine uploads that cannot be checked; false = fail open
CSAM_FAIL_CLOSED="false"
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0"
